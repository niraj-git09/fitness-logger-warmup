# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Fill with your cloud MySQL credentials from Railway, Aiven, etc.)
DB_HOST=your-cloud-db-host.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=fitness_db
DB_SSL=true

# Security & Secrets (Use a strong random string)
JWT_SECRET=your_production_jwt_secret_key_here
